{
  "name": "flux",
  "private": true,
  "version": "0.1.0",
  "description": "Flux — a fast, reliable, honestly priced alternative to Jira",
  "packageManager": "pnpm@9.12.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=9.0.0"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "pnpm -r lint",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "test:integration": "pnpm -r test:integration",
    "test:e2e": "pnpm --filter @flux/web test:e2e",
    "db:up": "docker compose up -d postgres redis",
    "db:migrate": "node scripts/migrate.mjs up",
    "db:status": "node scripts/migrate.mjs status",
    "db:check": "node scripts/migrate.mjs check",
    "infra:up": "docker compose up -d",
    "infra:down": "docker compose down",
    "check:rls": "node scripts/check-rls.mjs",
    "format": "prettier --write ."
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "@types/node": "^22.7.0",
    "eslint": "^9.12.0",
    "pg": "^8.13.0",
    "prettier": "^3.3.3",
    "typescript": "^5.6.0",
    "typescript-eslint": "^8.18.0"
  }
}
