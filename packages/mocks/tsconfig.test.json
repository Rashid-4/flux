{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    /**
     * Node types for the test files only. The source is checked by
     * tsconfig.json with `types: []`, which is where the no-ambient-API
     * guarantee lives — this config deliberately does NOT relax that for
     * `src/**`, it just adds what the test runner needs.
     */
    "types": ["node"]
  },
  "include": ["src/**/*.ts"],
  "exclude": ["dist", "node_modules"]
}
