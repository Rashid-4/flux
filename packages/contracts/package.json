{
  "name": "@flux/contracts",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Single source of truth for Flux domain types, validation schemas, and the event catalog. Depended on by the API, the web app, and every worker.",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json && tsc -p tsconfig.test.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "lint": "eslint src"
  },
  "dependencies": {
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "typescript": "^5.6.0",
    "vitest": "^2.1.0"
  }
}
