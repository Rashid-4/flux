{
  "name": "@flux/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "The flux API. A modular monolith over PostgreSQL, where tenant isolation is enforced by row-level security rather than by WHERE clauses. Every query goes through withTenant().",
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.json && tsup",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json",
    "lint": "eslint src tsup.config.ts vitest.config.ts vitest.integration.config.ts",
    "test": "vitest run --config vitest.config.ts",
    "test:watch": "vitest --config vitest.config.ts",
    "test:integration": "vitest run --config vitest.integration.config.ts"
  },
  "dependencies": {
    "@flux/contracts": "workspace:*",
    "@nestjs/common": "^12.0.1",
    "@nestjs/core": "^12.0.1",
    "@nestjs/platform-fastify": "^12.0.1",
    "fastify": "5.12.1",
    "pg": "^8.13.0",
    "pino": "^10.3.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.2",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/node": "^22.9.0",
    "@types/pg": "^8.11.10",
    "tsup": "^8.5.1",
    "tsx": "^4.23.13",
    "typescript": "^5.6.0",
    "vitest": "^4.0.0"
  }
}
