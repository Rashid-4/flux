# ─────────────────────────────────────────────────────────────────────────────
# A working development environment for services/api. Copy to .env and edit.
#
#   cp services/api/.env.example services/api/.env
#
# .env is gitignored; this file is not. **No real value belongs here.** The one
# credential below is the development bootstrap password from db/bootstrap/
# 00-roles.sql, which exists in the repository already and grants access to a
# throwaway container on loopback. Production values come from Vault or the
# cloud provider's KMS and are injected as environment variables by the
# deployment, never written to a file in the image.
#
# Every variable is optional except DATABASE_URL. The defaults below are the
# schema's own defaults, spelled out so that changing one is a one-line edit
# rather than a search through src/config.ts — which is where the reasoning for
# each of them lives, and is worth reading before overriding any of the four
# timeouts.
# ─────────────────────────────────────────────────────────────────────────────

# ── Process ──────────────────────────────────────────────────────────────────

# development | test | production. Anything else refuses to start.
NODE_ENV=development

# 0 lets the OS choose, which is what the integration suite uses so that a test
# run and a dev server do not fight over 3000.
PORT=3000

# Loopback by default, deliberately: a service that binds 0.0.0.0 because that
# is the framework default is exposed on every interface of a laptop the first
# time it joins a coffee-shop network. Containers set 0.0.0.0 explicitly.
HOST=127.0.0.1

# fatal | error | warn | info | debug | trace | silent
LOG_LEVEL=debug

# ── Database ─────────────────────────────────────────────────────────────────

# The only required variable, and the only one carrying a password.
#
# flux_app is NOBYPASSRLS and NOSUPERUSER — that is the whole tenant-isolation
# boundary, so do not point this at flux_migrator to make a migration run. Use
# `pnpm db:migrate`, which has its own credentials.
#
# There is deliberately no DATABASE_RELAY_URL. The outbox relay needs
# flux_relay, which holds BYPASSRLS because draining the outbox is cross-tenant
# by definition, and it is a separate deployable for exactly that reason: if
# this process held those credentials, every isolation guarantee in the product
# would rest on no code path in a large API ever reaching the wrong pool.
#
# Port note: `pnpm db:up` publishes 5432. If 5432 is already taken on your
# machine — see services/api/README.md, "The database this was verified
# against" — substitute the published port here and nowhere else.
DATABASE_URL=postgres://flux_app:flux_app_dev@127.0.0.1:5432/flux

# Pooled connections per process, 1–100. The number that matters is this times
# the replica count against Postgres's max_connections. Kept low on purpose: a
# request holds its connection for the whole transaction, so a large pool mostly
# buys the ability to overwhelm the database faster.
DATABASE_POOL_MAX=10

# How long pool.connect() waits for a free connection, 100–60000ms. Never 0:
# pg's own default means wait forever, which turns one slow query into a process
# where every request hangs and none errors.
DATABASE_CONNECT_TIMEOUT_MS=5000

# ── Per-transaction timeouts ─────────────────────────────────────────────────
#
# Applied as SET LOCAL inside every tenant transaction, so each is a ceiling for
# one request rather than a server-wide setting. Write paths pass lower values.

# statement_timeout, 100–120000ms.
STATEMENT_TIMEOUT_MS=10000

# lock_timeout, 50–30000ms. Much shorter than the statement timeout on purpose:
# a query waiting on a row lock will not get faster by waiting, and two people
# dragging the same card on a board is the expected case, not the exceptional
# one. Short here means contention becomes a fast retryable error.
LOCK_TIMEOUT_MS=3000

# idle_in_transaction_session_timeout, 1000–120000ms. The backstop for network
# I/O inside a transaction callback: an abandoned transaction holds its locks and
# blocks VACUUM across the whole database, not just its own request.
IDLE_IN_TRANSACTION_TIMEOUT_MS=15000
