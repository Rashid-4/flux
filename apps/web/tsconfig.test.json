{
  /**
   * Everything that runs under a test runner: `src/**\/*.test.ts(x)`, the
   * shared harness in `src/test/`, and the Playwright specs in `e2e/`.
   *
   * It exists to add node types for the files that legitimately need them — a
   * token-drift test reads `tokens.css` off disk, the MSW node server is node —
   * without relaxing that guarantee for `src/`. tsconfig.json checks the
   * application with `types: ["vite/client"]` only, so a `node:fs` import that
   * strays out of a test file fails there. Dropping either half loses it.
   *
   * `e2e/` lives here rather than in tsconfig.node.json because Playwright specs
   * need node *and* the DOM (anything inside `page.evaluate` is browser code),
   * and this is the config that already has both.
   */
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "types": ["vite/client", "node"]
  },
  "include": ["src", "e2e"],
  "exclude": ["dist", "node_modules"]
}
