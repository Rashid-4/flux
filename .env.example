# ─────────────────────────────────────────────────────────────
# Flux — local development environment
# Copy to .env and fill in. NEVER commit .env.
# In production, every value below comes from Vault / cloud KMS,
# not from a file. See docs/architecture.md §Security.
# ─────────────────────────────────────────────────────────────

NODE_ENV=development
LOG_LEVEL=debug

# ── API ──────────────────────────────────────────────────────
API_PORT=4000
API_PUBLIC_URL=http://localhost:4000
WEB_PUBLIC_URL=http://localhost:5173

# ── Postgres ─────────────────────────────────────────────────
# flux_app is the RLS-bound role the API connects as.
# flux_migrator has BYPASSRLS and is used ONLY by migrations.
DATABASE_URL=postgres://flux_app:flux_app_dev@localhost:5432/flux
DATABASE_MIGRATOR_URL=postgres://flux_migrator:flux_migrator_dev@localhost:5432/flux
DATABASE_POOL_MAX=20
DATABASE_STATEMENT_TIMEOUT_MS=10000

# ── Redis ────────────────────────────────────────────────────
REDIS_URL=redis://localhost:6379

# ── Search (Meilisearch) ─────────────────────────────────────
MEILI_URL=http://localhost:7700
MEILI_MASTER_KEY=flux_dev_master_key_change_me

# ── Event backbone (NATS in dev, Kafka in prod) ──────────────
EVENT_BUS_DRIVER=nats
NATS_URL=nats://localhost:4222
OUTBOX_RELAY_POLL_MS=250
OUTBOX_RELAY_BATCH_SIZE=200

# ── Temporal (durable workflows: automation, imports, SLAs) ──
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default
TEMPORAL_TASK_QUEUE=flux-main

# ── Object storage (MinIO in dev, S3 in prod) ────────────────
S3_ENDPOINT=http://localhost:9000
S3_REGION=us-east-1
S3_BUCKET_ATTACHMENTS=flux-attachments
S3_ACCESS_KEY_ID=flux_dev
S3_SECRET_ACCESS_KEY=flux_dev_secret
S3_FORCE_PATH_STYLE=true

# ── Auth (OIDC — Keycloak in dev) ────────────────────────────
OIDC_ISSUER_URL=http://localhost:8080/realms/flux
OIDC_CLIENT_ID=flux-api
OIDC_CLIENT_SECRET=replace_me
SESSION_COOKIE_NAME=flux_sid
SESSION_SECRET=replace_me_with_32_bytes_min

# ── Observability ────────────────────────────────────────────
OTEL_EXPORTER_OTLP_ENDPOINT=http://localhost:4318
OTEL_SERVICE_NAME=flux-api
SENTRY_DSN=

# ── Feature flags ────────────────────────────────────────────
FEATURE_FLAG_DRIVER=env
FLAG_JIRA_IMPORT=true
FLAG_AUTOMATION=false
FLAG_ANALYTICS=false
FLAG_OFFLINE_CRDT=false
FLAG_AI_TRIAGE=false
