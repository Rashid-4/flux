{
  "semi": false,
  "singleQuote": true,
  "printWidth": 100,
  "trailingComma": "all",
  "arrowParens": "always",
  "endOfLine": "lf",
  "proseWrap": "preserve",
  "plugins": ["prettier-plugin-tailwindcss"],
  "tailwindStylesheet": "apps/web/src/design/tokens.css",
  "tailwindFunctions": ["cn", "cva"],
  "overrides": [
    {
      "files": "*.md",
      "options": { "embeddedLanguageFormatting": "off" }
    }
  ]
}
